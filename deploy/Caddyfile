{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Upload limit (voice notes). The API enforces MAX_UPLOAD_MB as well.
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}

	# Health/readiness are for Docker only.
	@internal path /healthz /readyz
	respond @internal 404

	reverse_proxy api:8000 {
		health_uri /healthz
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}

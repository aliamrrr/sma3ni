# Copy to .env, then: chmod 600 .env. Never commit .env (it is git-ignored).
#
# Generate secrets with:
#   openssl rand -hex 32                                                                    (passwords)
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  (CONTACT_ENC_KEY)
#
# AWS credentials do NOT go here. On EC2 the instance role provides temporary credentials
# (IMDSv2). For local tests against S3, use `aws sso login` / a named profile, not static keys.

# ---------------------------------------------------------------- edge
DOMAIN=sma3ni.example.com
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------- secrets (required)
POSTGRES_PASSWORD=
NATS_PASSWORD=
# Fernet key(s) for citizen contacts. Rotation: "new_key,old_key"
CONTACT_ENC_KEY=

# ---------------------------------------------------------------- audio storage
# local = Docker volume on the server; s3 = Amazon S3 (set automatically by docker-compose.aws.yml)
STORAGE_BACKEND=local
# Values printed by `terraform output env_lines` (deploy/aws/terraform)
S3_BUCKET=
S3_PREFIX=audio
AWS_REGION=eu-west-3
# aws:kms (default) | AES256 | empty to rely on the bucket default encryption
S3_SSE=aws:kms
# Optional customer-managed KMS key ARN (the instance role then needs kms:GenerateDataKey/Decrypt on it)
S3_KMS_KEY_ID=

# ---------------------------------------------------------------- models
# Hugging Face token, only if a model repository is gated or private
HF_TOKEN=
# Pin reviewed model commits in production ("Files and versions" tab on Hugging Face)
ASR_REVISION=
LID_REVISION=

# ---------------------------------------------------------------- sizing
# GPU (AWS g6.2xlarge): ASR_DEVICE=cuda is set by docker-compose.aws.yml, ASR_MEM_LIMIT=20g
# CPU server: ASR_THREADS x asr-worker replicas ~= vCPUs, ASR_MEM_LIMIT=14g per worker
ASR_THREADS=8
ASR_DTYPE=bfloat16
ASR_MEM_LIMIT=20g
API_WORKERS=2
PG_SHARED_BUFFERS=1GB

# ---------------------------------------------------------------- data policy
AUDIO_RETENTION_DAYS=7
MAX_UPLOAD_MB=10
MAX_AUDIO_SECONDS=180
LID_MIN_CONFIDENCE=0.5
PUBLIC_HOURLY_LIMIT=5
